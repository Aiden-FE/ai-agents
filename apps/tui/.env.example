# Shell: @maka/tui. Loaded automatically by `pnpm --filter @maka/tui dev`.

# Agent layer, owned by @maka/core (see packages/core/README.md).

# Required: Vercel AI Gateway API key, read by the AI SDK.
AI_GATEWAY_API_KEY=

# Optional: pick a profile from the config file instead of `defaultProfile`.
MAKA_PROFILE=

# Optional: config file path. Defaults to ~/maka/config.yaml.
MAKA_CONFIG_PATH=

# Optional: override the selected profile from the environment.
MAKA_AGENT_MODEL=
MAKA_AGENT_INSTRUCTIONS=
MAKA_AGENT_CONTEXT_SIZE=

# Shell layer, owned by this package.

# Optional: title rendered in the terminal UI header.
MAKA_TUI_TITLE=
