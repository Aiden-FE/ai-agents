{
  "name": "@maka/tui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "maka-tui": "./dist/main.mjs"
  },
  "scripts": {
    "build": "tsdown",
    "start": "node --env-file-if-exists=.env dist/main.mjs",
    "dev": "tsdown && node --env-file-if-exists=.env dist/main.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cov": "vitest run --coverage",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@ai-sdk/tui": "^1.0.123",
    "@maka/core": "workspace:*",
    "ai": "^7.0.122",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
